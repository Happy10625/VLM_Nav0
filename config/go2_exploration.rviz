Panels:
- Class: rviz_common/Displays
  Name: Displays
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Map
    Name: Go2 map
    Alpha: 1.0
    Color Scheme: map
    Draw Behind: true
    Enabled: true
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /map
    Use Timestamp: false
  - Class: rviz_default_plugins/Map
    Name: Global Costmap
    Alpha: 0.5
    Color Scheme: map
    Draw Behind: false
    Enabled: true
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /global_costmap/costmap
    Use Timestamp: false
  - Class: rviz_default_plugins/Map
    Name: Local Costmap
    Alpha: 0.7
    Color Scheme: map
    Draw Behind: false
    Enabled: true
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /local_costmap/costmap
    Use Timestamp: false
  - Class: rviz_default_plugins/Polygon
    Name: Robot footprint
    Alpha: 1.0
    Color: 80; 80; 80
    Enabled: true
    Topic:
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /local_costmap/published_footprint
  - Class: rviz_default_plugins/PointCloud2
    Name: Navigation obstacle cloud
    Alpha: 1.0
    Color: 0; 0; 0
    Color Transformer: FlatColor
    Position Transformer: XYZ
    Decay Time: 0
    Enabled: true
    Selectable: false
    Size (Pixels): 2
    Size (m): 0.02
    Style: Points
    Topic:
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /vlm_nav/obstacle_cloud
    Use Fixed Frame: true
  - Class: rviz_default_plugins/MarkerArray
    Name: Generated exploration candidates
    Enabled: true
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /vlm_nav/go2_exploration/generated_candidates
  - Class: rviz_default_plugins/MarkerArray
    Name: VLM selected observation point
    Enabled: true
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /vlm_nav/go2_exploration/selected_candidate
  - Class: rviz_default_plugins/Image
    Name: Go2 live RGB
    Enabled: true
    Normalize Range: true
    Transport Hint: raw
    Topic:
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /camera/camera/color/image_raw
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 20
  Name: root
  Tools:
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/Measure
  - Class: rviz_default_plugins/PublishPoint
    Single click: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /clicked_point
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Views:
    Current:
      Angle: 0.0
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 40
      Target Frame: <Fixed Frame>
Window Geometry:
  Height: 900
  Width: 1500
