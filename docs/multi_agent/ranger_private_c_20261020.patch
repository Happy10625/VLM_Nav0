+    state.resource_id='basket';state.token='basket-token';state.permit_command_id='b'
+    state.requested_resource='door'
+    grant=replace(command,action='GRANT_RESOURCE',resource_id='door',token='door-token',parent_command_id='b')
+    assert not machine.accept(grant,0).accepted
+    assert machine.state().token=='basket-token'
