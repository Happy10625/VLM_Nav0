+
+def test_no_region_no_exit_points_mission_preserves_ready_and_deposit_order():
+    mission=MockMission(simple_config())
+    assert mission.start().accepted
+    go2_exited=False
+    for _ in range(800):
+        mission.step()
+        go2_exited=go2_exited or mission.machines['go2'].state().exited
+        if any(robot=='ranger' and command.kind=='APPROACH_DEPOSIT' for robot,command in mission.executed):
+            assert go2_exited
+        assert all(not m.state().token and not m.state().requested_resource for m in mission.machines.values())
+    assert mission.coordinator.phase=='DONE',mission.coordinator.reason
+    deposits=[(r,c) for r,c in mission.executed if c.kind=='APPROACH_DEPOSIT']
+    assert [r for r,c in deposits]==['go2','ranger']
+    for robot,deposit in deposits:
+        exit_command=next(c for r,c in mission.executed if r==robot and c.kind=='EXIT')
+        assert exit_command.parent_command_id==deposit.command_id
+        assert exit_command.resource_id==exit_command.token==''
+        health=mission.adapters[robot].get_health()
+        radius=max(math.hypot(*p) for p in health.footprint)
+        assert math.hypot(health.pose.x-9.,health.pose.y-1.)>=1.+radius+.1
+
+
+@pytest.mark.parametrize('fault',['far_not_reached','moving','aborted'])
+def test_exit_requires_actual_clearance_success_and_stopped_before_ranger(fault):
+    mission=MockMission(simple_config());adapter=mission.adapters['go2']
+    original=adapter.advance;health=adapter.get_health
+    def advance(now):
+        exiting=any(row[2].goal_kind=='EXIT_NAV' for row in adapter.active.values())
+        if exiting and fault=='aborted':adapter.aborts=10
+        original(now)
+        if exiting and not adapter.active:
+            adapter.path=[]
+            if fault=='far_not_reached':adapter.pose=Pose2D(8.3,1.)
+            if fault=='moving':adapter.get_health=lambda:replace(health(),stopped=False)
+    adapter.advance=advance
+    assert mission.start().accepted
+    mission.run(500)
+    assert any(kind=='EXIT_NAV' for kind,_,_ in adapter.calls)
+    assert not mission.machines['go2'].state().exited
+    assert not any(r=='ranger' and c.kind=='APPROACH_DEPOSIT' for r,c in mission.executed)
+
